#!/usr/bin/env bash
set -euo pipefail

overview_dir="${1:?usage: niri-workspaces-hot-corner <overview-dir>}"
corner_size="${NIRI_WORKSPACES_HOT_CORNER_SIZE:-12}"
interval="${NIRI_WORKSPACES_HOT_CORNER_INTERVAL:-0.02}"
armed=1

start_overview() {
  pgrep -af "^qs .* -p ${overview_dir}|^qs -p ${overview_dir}" >/dev/null || qs -d -p "$overview_dir" >/dev/null 2>&1 || true
}

open_overview() {
  start_overview
  qs ipc -p "$overview_dir" call overview open >/dev/null 2>&1 || true
}

while true; do
  pos=$(hyprctl cursorpos 2>/dev/null || true)
  if [[ $pos =~ ^[[:space:]]*(-?[0-9]+),[[:space:]]*(-?[0-9]+) ]]; then
    x=${BASH_REMATCH[1]}
    y=${BASH_REMATCH[2]}

    if (( x >= 0 && x <= corner_size && y >= 0 && y <= corner_size )); then
      if (( armed )); then
        armed=0
        open_overview
      fi
    else
      armed=1
    fi
  fi

  sleep "$interval"
done
